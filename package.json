{
  "name": "supervisor-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Discord Staff Supervision, Guard Protection, Ticket SLA & Analytics Platform powered by TypeScript, Discord.js v14, BullMQ, PostgreSQL, and FastAPI.",
  "author": "ByEterNaL",
  "license": "MIT",
  "keywords": [
    "discord-bot",
    "discord-js-v14",
