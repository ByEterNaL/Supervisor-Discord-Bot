    "ioredis": "^5.7.0",
    "pino": "^9.7.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
